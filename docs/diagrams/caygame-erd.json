  "cards": [
    {
      "dot": "cyan",
      "title": "Khóa Chính & Khóa Ngoại",
      "items": [
        "order là trung tâm dữ liệu: liên kết với user, service, và cả 2 bậc rank bắt đầu và đích",
        "email trong user và slug trong game có ràng buộc duy nhất (uk)",
        "orderCode là mã công khai duy nhất dùng để đối soát thanh toán ngân hàng qua SePay"
      ]
    },
    {
      "dot": "amber",
      "title": "Bản Số Crow's Foot (Chân Quạ)",
      "items": [
        "Một người dùng đặt không hoặc nhiều đơn hàng (1:N)",
        "Một tựa game có một hoặc nhiều bậc rank bắt buộc (1:N bắt buộc)",
        "Liên kết đánh giá (review) với đơn hàng là tùy chọn (nét đứt) cho tới khi đơn hoàn tất"
      ]
    },
    {
      "dot": "emerald",
      "title": "Cấu Trúc Nhúng (Embedded Documents)",
      "items": [
        "accountInfo lưu trữ tài khoản, mật khẩu nick game dưới dạng sub-document trong order",
        "customOptions (cày siêu tốc +35%, chọn tướng tủ +25%) được lưu trực tiếp vào từng đơn hàng"
      ]
    }
